<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>14</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Authors>TheActualTwinkle</Authors>
    <Product>AiAssertions</Product>
    <Version>0.2.1-rc.1</Version>
    <PackageIcon>logo.png</PackageIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/TheActualTwinkle/AiAssertions</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/TheActualTwinkle/AiAssertions</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>ai;assertions;testing;llm;dotnet</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)README.md"
          Pack="true"
          PackagePath="\" />

    <None Include="$(MSBuildThisFileDirectory)docs\**\*"
          Exclude="$(MSBuildThisFileDirectory)docs\ai-test-flow.excalidraw"
          Pack="true"
          PackagePath="docs\" />

    <None Include="$(MSBuildThisFileDirectory).github\images\logo.png"
          Pack="true"
          PackagePath="/"
          Visible="false" />

    <None Include="$(MSBuildThisFileDirectory).github\images\ai-test-flow.png"
          Pack="true"
          PackagePath="/"
          Visible="false" />
  </ItemGroup>
</Project>
