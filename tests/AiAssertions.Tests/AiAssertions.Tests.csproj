      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/AiAssertions/AiAssertions.csproj" />
    <ProjectReference Include="../../src/AiAssertions.Anthropic/AiAssertions.Anthropic.csproj" />
  </ItemGroup>

</Project>
